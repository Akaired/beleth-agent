# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Alpaca (paper trading only — this project never uses live trading endpoints) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay the paper trading endpoint. There is no live-trading equivalent in this project.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- LLM layer (OpenRouter, OpenAI-compatible, reached via the OpenAI SDK) ---
OPENROUTER_KEY=
# Non-secret defaults below — override only if you know you need to.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model with tool-calling support. Swappable via config, never in code.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Supabase (shared persistence — agent writes with the service role, webapp reads) ---
# Required from milestone 4 onward: scripts/check_market_data.py persists every decision.
# The service-role key bypasses RLS and must never leave .env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token (sbp_...) for the Supabase Management API — migrations and admin
# queries from the terminal. Optional: the agent runtime never uses it.
SUPABASE_ACCESS_TOKEN=
# Build identifier stamped on every persisted decision row (optional, default "dev").
AGENT_VERSION=dev
