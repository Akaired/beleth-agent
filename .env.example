# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Alpaca (paper trading only — this project never uses live trading endpoints) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay the paper trading endpoint. There is no live-trading equivalent in this project.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- LLM layer (via LiteLLM — provider is config, never hardcoded in agent logic) ---
# Model string in LiteLLM format, e.g. "anthropic/claude-sonnet-5" or "openai/gpt-5".
# No default is set yet — see the project spec open decision #2 (default LLM provider).
LLM_MODEL=
# Only set the key(s) for the provider(s) you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
