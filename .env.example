# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Alpaca (paper trading only — this project never uses live trading endpoints) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must stay the paper trading endpoint. There is no live-trading equivalent in this project.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- LLM layer (OpenRouter, OpenAI-compatible, reached via the OpenAI SDK) ---
OPENROUTER_KEY=
# Non-secret defaults below — override only if you know you need to.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free model with tool-calling support. Swappable via config, never in code.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Supabase (shared persistence — agent writes, webapp reads) ---
# Not required yet for milestone 1 (read-only, no persistence). Added ahead of the milestone
# that wires up decision/trade logging.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
