# Environment for the Next.js webapp (webapp/). Copy to .env.local and fill in.

# --- Public Supabase configuration ---------------------------------------------
# PUBLIC by design: the anon key ships in the browser bundle and row visibility
# is enforced by the RLS policies in db/migrations/0003_anon_read_policies.sql +
# 0004_auth_roles.sql, not by key secrecy. The same two values also back the
# authenticated dashboard (Supabase Auth email + password, session cookies via
# @supabase/ssr, refreshed in src/proxy.ts). Never put the Supabase service-role
# key here — the webapp reads only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Alpaca paper account (server-side only) ----------------------------------
# Read by src/lib/alpaca.ts for the equity curve (GET /v2/account/portfolio/
# history). NOT NEXT_PUBLIC_* — these never reach the browser; the client chart
# calls /api/equity, which runs server-side. Paper keys are full trading keys
# (there is no read-only variant), so keep them in encrypted env only and never
# in the bundle. Same values as the agent's ALPACA_API_KEY / ALPACA_SECRET_KEY.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Optional overrides. The trading endpoint defaults to the paper one and must stay
# there; the market-data endpoint defaults to https://data.alpaca.markets.
ALPACA_API_BASE_URL=
ALPACA_DATA_BASE_URL=

# --- "Chat with Beleth" — AI/ML API (server-side only) -----------------------
# The dashboard chat (src/lib/chat/*, POST /api/chat) talks to AI/ML API
# (aimlapi.com), an OpenAI-compatible endpoint, on a FREE model with tool
# calling. NOT NEXT_PUBLIC_* — the key never reaches the browser; the loop runs
# server-side in the route handler. Separate from the agent's OpenRouter layer.
# AIML_MODEL / AIML_BASE_URL are optional (defaults in src/lib/chat/aiml.ts);
# without AIML_API_KEY the chat returns a "not configured" message.
AIML_API_KEY=
AIML_MODEL=openai/gpt-oss-20b
AIML_BASE_URL=https://api.aimlapi.com/v1
# Chat turns one registered account may take per UTC day. AIML_API_KEY is a single
# free-tier quota shared by every visitor, so this is what stops one account spending
# the day for everyone. Optional; defaults to 40. Master admin is exempt; the shared
# demo login has its own, smaller, per-browser allowance.
CHAT_DAILY_MESSAGES=40

# --- Demo dashboard account (server-side only, optional) --------------------
# Backs the "Demo" button on the public homepage: a server action signs in with
# these credentials and drops the visitor straight into the read-only backoffice
# (the account's profiles.role is 'demo_admin'). NOT NEXT_PUBLIC_* — the password
# never reaches the browser. Without DEMO_EMAIL the button falls back to /login.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Site identity (server-side only, optional) -------------------------------
# BELETH_MAIL_DOMAIN scopes the admin Email section to this project's own domain on a
# Resend account shared with other projects — a `from` outside it is refused. It is a
# scoping heuristic, not the access gate: the gate is the master-admin check inside
# `resendRequest`. BELETH_SITE_URL is the absolute origin used for images in email,
# which clients will not render from inline SVG or data: URIs. Both default to
# beleth.davidemaiorana.dev.
BELETH_MAIL_DOMAIN=
BELETH_SITE_URL=

# --- Resend (server-side only, optional) -------------------------------------
# Auth email is delivered by Supabase Auth over Custom SMTP (smtp.resend.com),
# NOT by the webapp. This key is used only by the admin panel's read-only
# status check (/dashboard/admin/email → GET api.resend.com/domains). Without
# it that panel just shows the manual checklist. NOT NEXT_PUBLIC_*.
RESEND_API_KEY=
